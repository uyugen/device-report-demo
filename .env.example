# Copy to .env; runtime secrets belong only in .env, never in Git.
# Start without a model first, then enable after configuring your own endpoint.
MODEL_API_KEY=
MODEL_BASE_URL=http://127.0.0.1:8057/v1
MODEL_NAME=Qwen3.5-27B-Q4_K_M
MODEL_API_STYLE=llama_cpp
LLM_ENABLED=false
# Conservative complete-input budget; set only according to the selected model's actual window.
MODEL_CONTEXT_TOKENS=65536
MODEL_TIMEOUT_SECONDS=900
